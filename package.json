{
  "name": "@dsh-external/dsh-blender-plugin",
  "version": "2.6.2",
  "description": "DSH × Blender 直连插件（v2.6.2，GUI 优先，无头备用）：15 个模型工具让 AI 直接驱动 Blender——视口/自定义视角、持久内核 Python、时间窗/帧序列观察、内环参数搜索、无头进程与热会话（see/watch/reset/preload/warmup）、作业层、事务回滚、配方库，以及 34 family / 228 op 的契约层（catalog / 判定 / 验收 / 造型 / 装配 / 白模 / 导出）。v2.6.2 新增曲面算法包 surface_*（loft/sweep/patch → tessellate → validate → export，M0–M2/M4；M3 fit 与 M5 blend/offset 未实现）。P0–P2 能力：交互式无头（rt_do/rt_see session、plan session=auto）、参考图量具（img_digest/probe/measure/calib）、装配扫描/清单/合并/修复/门/导出（asm_*）、白模与 Seedance 参考包（blockout refsheet/turntable）、同机位 QC（visualreport_report）、无头轮廓拟合（shapesolve_solve）、缺陷注入评估（eval_run）、强制门（gate_/deliver_export require_gate）。默认先开 GUI；无头备用；装完必须重启 DSH；唯一验收判据 doctor kind=ok；blender-modeling skill 随包自动注册。详见 README 与 docs/操作教程.md。",
  "private": false,
  "keywords": [
    "dsh",
    "blender",
    "ai-agent",
    "tooling",
    "bpy",
    "cycles",
    "skill",
    "modeling"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "addon",
    "lib",
    "runtime",
    "!runtime/ext/venv",
    "!runtime/ext/node_modules",
    "!runtime/ext/pkg.tgz",
    "!runtime/__pycache__",
    "!runtime/**/*.ts",
    "!runtime/**/*.mts",
    "!runtime/**/*.d.ts",
    "!lib/.build.lock",
    "!lib/.build-ok",
    "!runtime/*.bak-*",
    "!runtime/*.v1-*",
    "skills",
    "docs",
    "tests",
    "!**/__pycache__",
    "!**/*.pyc",
    "cordis.patch.yml",
    "dsh-blender.config.example.json",
    "README.md",
    "CHANGELOG.md",
    "MIGRATIONS.md",
    "!tests/**/*.ts",
    "!tests/**/*.mts"
  ],
  "license": "BSD-3-Clause",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "@deepseek-ai/schemastery": "^3.18.0",
    "cordis": ">=4.0.0-rc <5",
    "schemastery": "^3.18.0"
  },
  "//peerDependenciesMeta": "schemastery / cordis 在不同 DSH 版本间是有 scope / 无 scope 两种形态。两个名字都声明且都标 optional —— 任一满足即可，宿主给了哪个就用哪个（见 src/index.ts 的运行时解析）。",
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    },
    "schemastery": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-attachment": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-brand": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-scope": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "build": "node scripts/build.mjs all",
    "build:addon": "node scripts/build-addon.mjs",
    "check:addon": "node scripts/build-addon.mjs --check",
    "typecheck": "node scripts/typecheck.mjs -p tsconfig.runtime.json && node scripts/build.mjs runtime && node scripts/typecheck.mjs && node scripts/typecheck.mjs -p tsconfig.test.json",
    "typecheck:src": "node scripts/build.mjs runtime && node scripts/typecheck.mjs",
    "typecheck:test": "node scripts/typecheck.mjs -p tsconfig.test.json",
    "lint": "eslint src tests/unit/js tests/integration/js tests/helpers scripts runtime --max-warnings=0",
    "lint:fix": "eslint src tests/unit/js tests/integration/js tests/helpers scripts runtime --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/check-*.mjs\" \"eslint.config.mjs\" \"tsconfig*.json\" \".prettierrc.json\" \"tests/types/**/*.d.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/check-*.mjs\" \"eslint.config.mjs\" \"tsconfig*.json\" \".prettierrc.json\" \"tests/types/**/*.d.ts\"",
    "check:structure": "node scripts/check-structure.mjs",
    "check:build": "node scripts/check-build.mjs",
    "prepack": "npm run build && node scripts/check-build.mjs",
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs unit",
    "test:integration": "node scripts/test.mjs integration",
    "test:contract": "node scripts/test.mjs contract",
    "test:python": "node scripts/test.mjs python",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "build:host": "node scripts/build.mjs host",
    "build:runtime": "node scripts/build.mjs runtime",
    "typecheck:runtime": "node scripts/typecheck.mjs -p tsconfig.runtime.json",
    "test:parity": "node scripts/check-parity.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  }
}
