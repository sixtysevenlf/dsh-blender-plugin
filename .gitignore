# 依赖目录与依赖符号链接（node_modules/ 只匹配目录，符号链接需要不带斜杠的写法）
node_modules

# Python 缓存与测试缓存
__pycache__/
.pytest_cache/
.vitest/
*.pyc

# 本地覆盖配置
dsh-blender.config.json

# 本地打包产物（已提交的扩展 zip 除外）
*.tgz
*.zip
!extension/dsh_blender_bridge.zip

# 本地日志与桌面系统文件
*.log
.DS_Store

# Python 虚拟环境（open3d 等大依赖，1.2G，绝不入库；用 runtime/ext/README 里的安装说明重建）
venv/
.venv/

# Ruff 静态检查缓存
.ruff_cache/

# 构建产物（prepack 重建，不入库；目录与符号链接都匹配）
/lib

# coverage 产物（pytest-cov / coverage.py）
coverage/
.coverage

# OpenSpec 生成的 agent skill 目标（由 openspec 生成，不入库）
.agents/

# 本地工作笔记与证据：绝不入库
/docs/refactor/
/.dsh/

# Agent 临时工作区：不属于仓库，不存在时自行创建
/local-workspace/
# 本地 PR 审查工作区（绝不入库或随包发布）
/.review-tmp/

# 编辑器本地设置（setup-dev 按需创建）
.vscode/

# Windows hidden-desktop helper 构建输出（scripts/build-win-helper.mjs）
/native/win-hidden-desktop/out/

# Windows hidden-desktop helper 的发布暂存（仅 release 流水线使用）
/vendor/
