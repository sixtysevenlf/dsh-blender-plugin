{
  "venvPath": ".",
  "venv": ".venv",
  "include": [
    "runtime/py/_facade.py",
    "runtime/py/core/offline_bootstrap.py",
    "runtime/py/geometry/faceeval.py",
    "runtime/py/render/imgtools_impl/cache.py",
    "runtime/py/render/imgtools_impl/contour.py",
    "runtime/py/render/imgtools_impl/digest/numbers.py",
    "runtime/py/render/imgtools_impl/digest/prepare.py",
    "runtime/py/render/imgtools_impl/digest/result.py",
    "runtime/py/render/imgtools_impl/digest/shape.py",
    "runtime/py/render/imgtools_impl/digest/verdict.py",
    "runtime/py/render/imgtools_impl/digest/visual.py",
    "runtime/py/render/qc_render_impl/main.py",
    "runtime/py/render/qc_render_impl/parts.py",
    "runtime/vision/worker/main.py",
    "runtime/vision/worker/protocol.py",
    "runtime/vision/worker/models.py",
    "runtime/vision/worker/selftest.py",
    "runtime/vision/worker/analyze.py",
    "runtime/vision/worker/compare.py",
    "runtime/vision/worker/detect.py",
    "runtime/vision/worker/track.py",
    "runtime/vision/worker/common.py",
    "runtime/vision/worker/probe.py",
    "runtime/vision/worker/inference/opencv.py",
    "runtime/vision/worker/inference/onnxruntime.py",
    "runtime/vision/worker/inference/select.py"
  ],
  "exclude": ["**/__pycache__"],
  "typeCheckingMode": "basic",
  "reportMissingModuleSource": "none",
  "reportMissingTypeStubs": false,
  "extraPaths": [".", "runtime/vision/worker"],
  "executionEnvironments": [
    {
      "root": "runtime/vision/worker",
      "extraPaths": ["runtime/vision/worker"],
      "reportMissingImports": "none"
    }
  ]
}
